  <diagram name="Hình 12" id="f12">
    <mxGraphModel dx="1669" dy="1005" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cont" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;arcSize=8;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;dashed=1;dashPattern=8 4;verticalAlign=top;spacingTop=14;fontSize=12;" value="&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;VI ĐIỀU KHIỂN ESP32&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="555.1" width="468" x="45.5" y="91" as="geometry" />
        </mxCell>
        <mxCell id="main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;arcSize=8;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;LUỒNG CHÍNH&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Cân hàng bằng HX711, lọc nhiễu 2 tầng&lt;br&gt;• Bám line bằng PD, cảm biến TCRT5000&lt;br&gt;• Quét siêu âm, tự động dừng/chạy lại&lt;br&gt;• Xử lý 4 giao lộ, xác nhận dỡ hàng&lt;/font&gt;" vertex="1">
          <mxGeometry height="158.6" width="409.5" x="74.75" y="179.4" as="geometry" />
        </mxCell>
        <mxCell id="net" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;arcSize=8;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;LUỒNG MẠNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Tự duy trì kết nối Wi-Fi&lt;br&gt;• Gửi số liệu định kỳ mỗi 2,5 giây&lt;br&gt;• Gửi ngay khi đổi trạng thái, thử lại sau 0,5 giây&lt;br&gt;• Khóa đồng bộ tránh xung đột&lt;/font&gt;" vertex="1">
          <mxGeometry height="162.5" width="409.5" x="75.4" y="448.5" as="geometry" />
        </mxCell>
        <mxCell id="flask" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;arcSize=8;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;MÁY CHỦ PYTHON FLASK&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chạy trên laptop, cổng 5000&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;API 1:&lt;/b&gt; POST /api/telemetry&lt;br&gt;Nhận trạng thái, cân nặng, cảnh báo&lt;br&gt;&lt;b style=&quot;&quot;&gt;API 2:&lt;/b&gt; POST /api/delivery&lt;br&gt;Kiểm tra mã chuyến, cộng tồn kho&lt;br&gt;&lt;b style=&quot;&quot;&gt;API 3:&lt;/b&gt; GET /api/status&lt;br&gt;Trả dữ liệu tổng hợp cho Web&lt;br&gt;&lt;br&gt;• Báo mất kết nối sau 15 giây&lt;/font&gt;" vertex="1">
          <mxGeometry height="286" width="312" x="578.5" y="179.4" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;arcSize=8;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;b style=&quot;color: rgb(0, 0, 0);&quot;&gt;GIAO DIỆN WEBSITE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;1. Giám sát&lt;/b&gt;&lt;br&gt;Trạng thái xe và kết nối&lt;br&gt;Khối lượng, loại hàng, cảnh báo vật cản&lt;br&gt;&lt;b style=&quot;&quot;&gt;2. Quản lý Kho 1 và Kho 2&lt;/b&gt;&lt;br&gt;Số kiện, tổng khối lượng&lt;br&gt;Lịch sử giao nhận&lt;br&gt;&lt;b style=&quot;&quot;&gt;3. Xuất báo cáo&lt;/b&gt;&lt;br&gt;File CSV theo ngày&lt;br&gt;In phiếu kiểm kê kho&lt;/font&gt;" vertex="1">
